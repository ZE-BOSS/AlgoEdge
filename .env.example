# ============================================================
# AlgoEdge Trading Bot — Backend Environment Configuration
# Copy this to .env and fill in your credentials
# ============================================================

# ── JWT Authentication ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=my-secret-key-is-here-min-32-chars
JWT_ACCESS_EXPIRE_MINUTES=10080
JWT_REFRESH_EXPIRE_DAYS=30

# ── Database (PostgreSQL on Railway) ─────────────────────────
DATABASE_URL=postgresql://postgres:cLurhcRVFoBfEOCCEykSraPhdNgLxANs@reseau.proxy.rlwy.net:23220/railway

# ── Redis (Optional — graceful skip) ─────────────────────────
REDIS_URL=redis://default:UXcsZWxTkQsWvaeajhtaAMGIpMhYLaSP@reseau.proxy.rlwy.net:53621

# ── Backend Server (runs locally on Windows) ─────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ── Frontend URL (for CORS) ──────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-is-here

# ── VAPID Keys (Push Notifications) ─────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:ikchristo19@gmail.com

# ── LLM API Keys (Optional — encrypted before DB storage) ───
# These are only used for initial setup; after first run they
# are stored encrypted in PostgreSQL via the API key store.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
