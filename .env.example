# AlgoEdge environment template — copy to .env and fill in. Never commit .env.
# The real values live in .env locally and in secrets/algoedge.env.enc (encrypted)
# for the VPS. See docs/SECRETS.md.

# ── MetaTrader 5 ─────────────────────────────────────────────────────────────
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
DERIV_MT5_ACCOUNT=
DERIV_MT5_PASSWORD=
DERIV_MT5_SERVER=
DERIV_MT5_PATH=

# ── App ──────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///algoedge.db
REDIS_URL=redis://localhost:6379/0
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Web push (browser notifications) — generate your own pair with `py -m py_vapid`
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@algoedge.test

# ── Investor platform ────────────────────────────────────────────────────────
INVESTOR_APP_URL=https://app.alphavantiqcapital.com   # links in invites/emails; allowed by CORS
ADMIN_APP_URL=https://admin.alphavantiqcapital.com    # links in admin emails; allowed by CORS
PUBLIC_SITE_URL=https://alphavantiqcapital.com        # the landing page; allowed by CORS
INVESTOR_JWT_SECRET=          # optional; derived from JWT_SECRET_KEY when blank. Set it in production.
CORS_STRICT=                  # 1 in production: only the four sites above may call the API
INVESTOR_JOBS=on              # nightly ledger check + daily digest; off to disable
INVESTOR_DAILY_DIGEST=on      # the admin's daily summary email

# Email (Resend). The real key goes in .env only — never in this file.
RESEND_API_KEY=               # re_... from resend.com → API Keys
EMAIL_FROM=Alphavantiq Capital <no-reply@alphavantiqcapital.com>   # domain must be verified in Resend
EMAIL_REPLY_TO=               # where investor replies go, e.g. invest@alphavantiqcapital.com
ADMIN_ALERT_EMAIL=            # new-device logins, applications, daily digest
EMAIL_MODE=live               # live | log  (log = write to email_log, send nothing)

# ── Market and macro data ────────────────────────────────────────────────────
FRED_API_KEY=                 # free — fred.stlouisfed.org (macro series, release vintages)
FINNHUB_API_KEY=              # free — economic calendar, insider transactions, news
ALPHAVANTAGE_API_KEY=         # free, 25 requests/day — daily equity and ETF history
TIINGO_API_KEY=               # free — EOD equity and ETF history
POLYGON_API_KEY=              # options and equities (already used by data/providers.py)
DATABENTO_API_KEY=            # optional, paid

# ── Crypto ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=               # free — Solana RPC and parsed transactions
DUNE_API_KEY=                 # on-chain SQL (free tier is view-only since Sept 2026)
BIRDEYE_API_KEY=              # token trades, holders, OHLCV (history needs a paid tier)
COINGECKO_API_KEY=            # free demo key — prices, market caps
GOPLUS_APP_KEY=               # free — token security and honeypot checks
GOPLUS_APP_SECRET=

ALGOEDGE_MT5_SERVER_UTC_OFFSET=3
# ── Behind Caddy (docs/DEPLOY-INVESTOR-PLATFORM.md) ─────────────────────────
# Read by ecosystem.config.js at `pm2 start` (a Machine environment variable wins).
ALGOEDGE_CADDY=               # 1 = serve through Caddy on 80/443
CADDY_BIN=                    # default C:/caddy/caddy.exe
ACME_EMAIL=                   # a real address, for Let's Encrypt expiry notices
ADMIN_ALLOW_IPS=              # YOUR home/office IP(s), space-separated — not the server's
ADMIN_EMAILS=                 # comma-separated operator accounts made admins at startup (default: the oldest account, if no admin exists)
