# AlgoEdge backend .env for instance "__NAME__" (Linux + Wine MT5 bridge).
# Created by add_instance.sh. Fill in every CHANGE_ME, copying the values from
# your current server's .env. Never commit this file.

# -- This instance ----------------------------------------------------------
HOST=127.0.0.1
PORT=__API_PORT__
ALGOEDGE_SERVER_ROLE=__NAME__
ALGOEDGE_SERVER_LABEL=__NAME__ (Linux)
DATABASE_URL=sqlite+aiosqlite:///algoedge.db
REDIS_URL=redis://localhost:6379/__REDIS_DB__

# -- MT5, through the Wine bridge ---------------------------------------------
# The bridge address/key come from /opt/algoedge/__NAME__/instance.env (set by
# add_instance.sh); MT5_PATH is the terminal INSIDE this instance's Wine prefix.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_ACCOUNT=CHANGE_ME
MT5_PASSWORD=CHANGE_ME
MT5_SERVER=CHANGE_ME
# The MT5 server clock is detected automatically; only pin it if the
# detection is wrong for your broker (Deriv's server runs on UTC).
# ALGOEDGE_MT5_SERVER_UTC_OFFSET=0

# -- Auth / security (copy from the current server) --------------------------
JWT_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
ADMIN_EMAILS=CHANGE_ME
ALLOW_REGISTRATION=false
# CORS: with CORS_STRICT on, ONLY these sites may call this API - put your
# Vercel frontend's address in ADMIN_APP_URL (or FRONTEND_URL).
CORS_STRICT=true
ADMIN_APP_URL=https://admin.alphavantiqcapital.com
FRONTEND_URL=
INVESTOR_APP_URL=
PUBLIC_SITE_URL=

# -- Optional: email, Telegram, push, LLM keys - copy what you use ------------
# RESEND_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# ANTHROPIC_API_KEY=
