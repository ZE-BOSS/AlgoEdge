//@version=6
// Roboquant template "T-Mean Reversion" — line-by-line Pine port of the rq_sdk (Rust) source.
// Preset (showcase run): MNQ 1h, entry Friday 18:00 UTC if the last completed Friday closed red,
// exit Wednesday 10:00 UTC, fixed-dollar sizing $100 (= 2 MNQ), market-hours filter off. Long only, no SL/TP.
strategy("RQ T-Mean Reversion", shorttitle="RQ T-Mean", overlay=true, pyramiding=0,
     initial_capital=10000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.5, slippage=0, margin_long=0, margin_short=0)

lot_size              = input.float(1.0, "Position Size (lots/contracts)", minval=0.01, maxval=50, step=0.01)
use_fixed_dollar_risk = input.bool(true, "Use Fixed-Dollar Risk Sizing", tooltip="code default off, preset on")
fixed_risk_dollars    = input.float(100.0, "Fixed Risk Amount ($)", minval=1, tooltip="code default 1000, preset 100")
entry_day    = input.int(5, "Entry Day (1=Mon)", minval=1, maxval=7, tooltip="code default 1, preset 5")
entry_hour   = input.int(18, "Entry Hour (UTC)", minval=0, maxval=23, tooltip="code default 17, preset 18")
entry_minute = input.int(0, "Entry Minute", minval=0, maxval=59)
exit_day     = input.int(3, "Exit Day (3=Wed)", minval=1, maxval=7)
exit_hour    = input.int(10, "Exit Hour (UTC)", minval=0, maxval=23, tooltip="code default 20, preset 10")
exit_minute  = input.int(0, "Exit Minute", minval=0, maxval=59)
check_market_hours = input.bool(false, "Check Market Hours")
market_open_hour   = input.int(1, "Market Open Hour (UTC)", minval=0, maxval=23)
market_close_hour  = input.int(23, "Market Close Hour (UTC)", minval=0, maxval=23)
grpX = "Port / cross-asset (not in the Roboquant code)"
qtyLev = input.float(0.0, "Override size: notional = x equity (0 = code sizing)", minval=0, step=0.1, group=grpX)
cfdLev = input.float(1.0, "Non-futures symbols (Deriv/CFD/crypto): notional = x equity when the override is 0", minval=0.01, step=0.1, group=grpX)
tFrom  = input.time(timestamp("2000-01-01T00:00:00"), "Trade from", group=grpX)
tTo    = input.time(timestamp("2100-01-01T00:00:00"), "Trade until", group=grpX)

calendar_weekday(int t) =>
    int w = dayofweek(t, "UTC")   // 1=Sun..7=Sat in Pine
    w == dayofweek.sunday ? 7 : w - 1

int date_num = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
int weekday  = calendar_weekday(time)
int hr       = hour(time, "UTC")
int mn       = minute(time, "UTC")

var int   cur_day = 0
var float cur_day_open = na
var int   cur_day_weekday = na
var bool  last_friday_red = false
var bool  have_friday_result = false
var bool  in_position = false
var int   last_entry_date = 0
var int   last_exit_date = 0

calculate_lot_size() =>
    float point_value = syminfo.pointvalue * syminfo.mintick
    if point_value <= 0
        lot_size
    else
        float size = fixed_risk_dollars / (100.0 * point_value)
        size < 1.0 ? 1.0 : size

if cur_day == 0
    cur_day := date_num
    cur_day_open := open
    cur_day_weekday := weekday
else if date_num != cur_day
    if cur_day_weekday == 5
        last_friday_red := close[1] < cur_day_open
        have_friday_result := true
    cur_day := date_num
    cur_day_open := open
    cur_day_weekday := weekday

bool skip = check_market_hours and (hr < market_open_hour or hr >= market_close_hour)
if not skip
    if weekday == entry_day and hr == entry_hour and mn >= entry_minute
        if date_num != last_entry_date and not in_position
            last_entry_date := date_num
            if have_friday_result and last_friday_red and time >= tFrom and time <= tTo
                float qty = use_fixed_dollar_risk ? calculate_lot_size() : lot_size
                int contracts = int(math.max(math.floor(qty), 1.0))
                float lev = qtyLev > 0 ? qtyLev : syminfo.type != "futures" ? cfdLev : 0.0
                float q = lev > 0 ? strategy.equity * lev / (close * syminfo.pointvalue) : contracts
                strategy.entry("Long", strategy.long, qty=q, comment="Friday red")
                in_position := true
    if weekday == exit_day and hr == exit_hour and mn >= exit_minute
        if date_num != last_exit_date and in_position
            last_exit_date := date_num
            strategy.close_all(comment="Exit day")
            in_position := false

bgcolor(have_friday_result and last_friday_red ? color.new(color.red, 94) : na, title="Last Friday red")
